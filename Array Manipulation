#include <stdio.h>
#include <stdlib.h>

long arrayManipulation(int n, int queries_rows, int queries_columns, int** queries)
{
    long *arr = (long *)calloc(n + 2, sizeof(long));

    for (int i = 0; i < queries_rows; i++)
    {
        int a = queries[i][0];
        int b = queries[i][1];
        long k = queries[i][2];

        arr[a] += k;
        arr[b + 1] -= k;
    }

    long current = 0;
    long maximum = 0;

    for (int i = 1; i <= n; i++)
    {
        current += arr[i];

        if (current > maximum)
        {
            maximum = current;
        }
    }

    free(arr);

    return maximum;
}

int main()
{
    int n, q;
    scanf("%d %d", &n, &q);

    int **queries = (int **)malloc(q * sizeof(int *));

    for (int i = 0; i < q; i++)
    {
        queries[i] = (int *)malloc(3 * sizeof(int));

        scanf("%d %d %d",
              &queries[i][0],
              &queries[i][1],
              &queries[i][2]);
    }

    long result = arrayManipulation(n, q, 3, queries);

    printf("%ld\n", result);

    for (int i = 0; i < q; i++)
    {
        free(queries[i]);
    }

    free(queries);

    return 0;
}
